  "reasonFrd02": "ಸಂಬಳ ಚೀಟಿಯ ಆದಾಯ ಬ್ಯಾಂಕ್ ಜಮೆಗಳಿಗೆ ಹೊಂದುತ್ತಿಲ್ಲ. ಇತ್ತೀಚಿನ ಫಾರ್ಮ್ 16 ನೀಡಿ, ಅಥವಾ ಸಮ್ಮತಿಯೊಂದಿಗೆ ನಮಗೆ ಪಡೆಯಲು ಬಿಡಿ.",
  "reasonFrd03": "ನಿಮ್ಮ ಒಂದು ದಾಖಲೆ ನೀಡಿದ ಪ್ರಾಧಿಕಾರದ ಪರಿಶೀಲನೆಯಲ್ಲಿ ವಿಫಲವಾಗಿದೆ.",
  "reasonPol01": "ಅರ್ಜಿದಾರರಿಗೆ ಕನಿಷ್ಠ 21 ವರ್ಷ ವಯಸ್ಸಾಗಿರಬೇಕು.",
  "reasonPol02": "ಸಾಲ ನಾವು ಅನುಮತಿಸುವ ಗರಿಷ್ಠ ವಯಸ್ಸನ್ನು ಮೀರುತ್ತದೆ. ಕಿರಿಯ ಸಹ-ಅರ್ಜಿದಾರರನ್ನು ಸೇರಿಸಿದರೆ ಸಹಾಯವಾಗಬಹುದು.",
  "reasonBur01": "ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ಸ್ಕೋರ್ ನಮ್ಮ ಕನಿಷ್ಠ 650 ಕ್ಕಿಂತ ಕಡಿಮೆಯಿದೆ.",
  "reasonBur04": "ನಿಮಗೆ ಇನ್ನೂ ಕ್ರೆಡಿಟ್ ಇತಿಹಾಸವಿಲ್ಲ, ಹಾಗಾಗಿ ಒಬ್ಬ ಅಧಿಕಾರಿ ನಿಮ್ಮ ಬ್ಯಾಂಕ್ ದಾಖಲೆಗಳನ್ನು ನೋಡುತ್ತಾರೆ.",
  "reasonBur05": "ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ಸ್ಕೋರ್ ಅನ್ನು ಅಧಿಕಾರಿ ಗಮನವಿಟ್ಟು ನೋಡಬೇಕು.",
  "reasonPrp01": "ನಮ್ಮ ವಕೀಲರು ಆಸ್ತಿಯ ಹಕ್ಕನ್ನು ಪರಿಶೀಲಿಸಬೇಕು.",
  "reasonPrp03": "ಮೌಲ್ಯ ದೃಢೀಕರಿಸಲು ನಮ್ಮ ಮೌಲ್ಯಮಾಪಕರು ಆಸ್ತಿಗೆ ಭೇಟಿ ನೀಡಬೇಕು.",
  "reasonPrp04": "ಒಪ್ಪಂದ ಮೌಲ್ಯ ಈ ಆಸ್ತಿಯ ಸರ್ಕಾರಿ ಮಾರ್ಗಸೂಚಿ ದರಕ್ಕಿಂತ ಕಡಿಮೆಯಿದೆ. ದಯವಿಟ್ಟು ಮಾರಾಟ ಒಪ್ಪಂದ ಪರಿಶೀಲಿಸಿ.",
  "reasonAff01": "ನಿಮ್ಮ ಈಗಿನ EMI ಈಗಾಗಲೇ ಆದಾಯದ ಗರಿಷ್ಠ ಪಾಲನ್ನು ಬಳಸುತ್ತಿವೆ.",
  "reasonAut01": "ಈ ಗಾತ್ರದ ಸಾಲಗಳನ್ನು ಹಿರಿಯ ಅಧಿಕಾರಿ ಅಂತಿಮವಾಗಿ ಪರಿಶೀಲಿಸುತ್ತಾರೆ.",
  "reasonRsk01": "ಆಫರ್ ಅಂತಿಮಗೊಳಿಸಲು ಒಬ್ಬ ಅಧಿಕಾರಿ ನಿಮ್ಮ ಅರ್ಜಿ ನೋಡುತ್ತಾರೆ.",
